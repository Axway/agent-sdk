                "type": "number"
              }
            ]
          },
          "params": {
            "type": "object",
            "description": "A structured value that holds the parameter values to be used during the invocation of the method"
          },
          "jsonrpc": {
            "type": "string",
            "enum": [
              "2.0"
            ]
          }
        }
      }
    },
    "responses": {}
  }
